# Copy this file to .env and fill in real values. Never commit .env.

# Required: any long random string (python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me

# Cashfree (sandbox keys while testing)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_MODE=sandbox
CASHFREE_API_VERSION=2025-01-01

# Public https address of the deployed site, no trailing slash.
# Used for the Cashfree return/webhook URLs. Leave empty for local testing.
PUBLIC_BASE_URL=

# Optional: folder for database.db and uploads/ (point at a persistent disk on Render)
DATA_DIR=

# Set to 1 only on your own computer
FLASK_DEBUG=0
